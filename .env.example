# Copy this file to .env and fill in your real key.
# Never commit the real .env file.

TRANSCRIPT_OPENROUTER_KEY=your_openrouter_api_key_here

# Optional: change the port (defaults to 3000)
# PORT=3000

# --- Audio splitting (Phase 1+) ---
# CHUNK_TARGET_SEC=300
# CHUNK_SEARCH_WINDOW_SEC=60
# CHUNK_MIN_SEC=60
# SILENCE_NOISE_DB=-30
# SILENCE_MIN_DURATION=0.4

# --- Concurrency ---
# API_CONCURRENCY=4

# --- Translation ---
# TRANSLATION_BATCH_SIZE=40
# TRANSLATION_CONTEXT_SEGMENTS=3

# --- Whisper ---
# WHISPER_PROMPT=
